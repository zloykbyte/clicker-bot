BOT_TOKEN=сюда_вставьте_новый_токен_от_BotFather

# Строка подключения к Postgres. Обязательна и для локального запуска, и для Vercel —
# своего файла базы данных (SQLite) больше нет. На Vercel обычно достаточно подключить
# интеграцию Vercel Postgres (или другой Postgres-провайдер) — тогда переменная
# POSTGRES_URL появится в проекте автоматически и подхватится сама.
# Для локального запуска укажите свою: DATABASE_URL=postgres://user:pass@host:5432/dbname
# DATABASE_URL=

# Telegram ID администратора: только он видит /admin (узнать можно у @userinfobot)
ADMIN_ID=

# Публичный https-адрес бота. Локально — туннель (cloudflared и т.п.), на Vercel —
# адрес вашего деплоя, например https://my-project.vercel.app. Без него рейтинг в
# Mini App и учёт посещений не работают, а на Vercel ещё и вебхук Telegram ставить некуда.
# API_PUBLIC_URL=
# API_HOST=127.0.0.1
# API_PORT=8080

# Секрет для проверки вебхука Telegram (используется только в режиме Vercel,
# см. README → «Деплой на Vercel»). Можно оставить пустым, но с секретом безопаснее —
# без него любой, кто узнает адрес /api/webhook, сможет слать туда поддельные апдейты.
# WEBHOOK_SECRET=

# Часовой пояс проекта (по нему считаются «сегодня», «вчера» и посещения)
# TZ_NAME=Europe/Moscow
