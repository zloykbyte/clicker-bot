BOT_TOKEN=сюда_вставьте_новый_токен_от_BotFather
# DB_PATH=clicker.db

# Telegram ID администратора: только он видит /admin (узнать можно у @userinfobot)
ADMIN_ID=

# Публичный https-адрес API бота (туннель или хостинг). Без него рейтинг в Mini App
# и учёт посещений не работают. Пример: https://my-tunnel.trycloudflare.com
# API_PUBLIC_URL=
# API_HOST=127.0.0.1
# API_PORT=8080

# Часовой пояс проекта (по нему считаются «сегодня», «вчера» и посещения)
# TZ_NAME=Europe/Moscow
